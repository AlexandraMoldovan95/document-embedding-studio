# Document Embedding Studio — backend configuration.
# Copy to .env and adjust. Every value below is the default, so an empty .env
# (or no .env at all) also works.

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000

# Storage — ChromaDB persists here and survives restarts.
CHROMA_DIR=./data/chroma
DEFAULT_COLLECTION=documents

# Embeddings — local sentence-transformers by default, no API key required.
# The model downloads (~90 MB) on first use and is cached afterwards.
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64
# Set true to load the model at startup instead of on the first request.
EMBEDDING_WARMUP=false

# Upload limits
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_REQUEST=25
